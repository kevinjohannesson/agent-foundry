{
  "name": "agent-foundry",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:core": "pnpm --filter @foundry/core dev",
    "test": "pnpm -r test",
